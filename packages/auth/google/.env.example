# Google OAuth 2.0 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Auto-create users on first login
GOOGLE_AUTO_CREATE_USERS=true

# Auto-sync user data (name, email, avatar) from Google
GOOGLE_AUTO_SYNC_USER_DATA=true

# Enable refresh token support for long-lived access
GOOGLE_ENABLE_REFRESH_TOKEN=true

# Access type: 'offline' for refresh token, 'online' for standard
GOOGLE_ACCESS_TYPE=offline

# Prompt behavior: 'none', 'consent', 'select_account'
GOOGLE_PROMPT=select_account

# Sanctum token configuration
GOOGLE_AUTH_TOKEN_NAME=google-auth-token

# Frontend redirect URL after authentication
FRONTEND_URL=http://localhost:3000
GOOGLE_AUTH_FRONTEND_REDIRECT_URL="${FRONTEND_URL}/auth/callback"

# Optional: Custom user model
# GOOGLE_AUTH_USER_MODEL=App\Models\User
