# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here

# Tenant Type
# - common: Multi-tenant and personal Microsoft accounts (recommended)
# - organizations: Work/school accounts only
# - consumers: Personal Microsoft accounts only
# - {tenant-id}: Specific Azure AD tenant
MICROSOFT_TENANT=common

# Redirect URIs
MICROSOFT_REDIRECT_URI=https://your-api.com/api/auth/microsoft/callback
MICROSOFT_FRONTEND_REDIRECT_URL=https://your-frontend.com/auth/callback

# Graph API Version (v1.0 or beta)
MICROSOFT_GRAPH_VERSION=v1.0

# Auto create user in users table
MICROSOFT_AUTO_CREATE_USER=true

# Store Microsoft tokens in database
MICROSOFT_STORE_TOKENS=true

# User model (optional, defaults to App\Models\User)
# MICROSOFT_USER_MODEL=App\Models\User
