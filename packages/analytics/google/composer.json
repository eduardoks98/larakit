{
    "name": "eduardoks98/analytics-google",
    "description": "Google Analytics (GA4) integration for Laravel - gtag.js implementation",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Eduardoks98\\AnalyticsGoogle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\AnalyticsGoogle\\GoogleAnalyticsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
