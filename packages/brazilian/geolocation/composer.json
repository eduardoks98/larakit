{
    "name": "eduardoks98/geolocation",
    "description": "Brazilian geolocation package with ViaCEP, address lookup, geocoding, and distance calculation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "eduardoks98/base-api": "^1.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\Geolocation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\Geolocation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\Geolocation\\GeolocationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
