{
    "name": "eduardoks98/sms-comtele",
    "description": "Comtele SMS integration for Laravel - Cost-effective SMS provider for Brazil with bulk sending support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8",
        "eduardoks98/base-api": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\SmsComtele\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\SmsComtele\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\SmsComtele\\SmsComteleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
