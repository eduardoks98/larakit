{
    "name": "eduardoks98/sms-twilio",
    "description": "Twilio SMS integration for Laravel - Send SMS globally with delivery tracking and templates support",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "twilio/sdk": "^8.0",
        "eduardoks98/base-api": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\SmsTwilio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\SmsTwilio\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\SmsTwilio\\SmsTwilioServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
