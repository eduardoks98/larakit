{
    "name": "eduardoks98/ads-applovin",
    "description": "AppLovin MAX Server-to-Server Callback Validation for Laravel - Event token verification and revenue reporting for rewarded ads",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "applovin",
        "max",
        "mediation",
        "rewarded-ads",
        "s2s-callback",
        "monetization",
        "game-monetization"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardo@example.com",
            "homepage": "https://github.com/eduardoks98"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "eduardoks98/base-api": "^1.0",
        "eduardoks98/monetization": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\AdsApplovin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\AdsApplovin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\AdsApplovin\\AdsApplovinServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
