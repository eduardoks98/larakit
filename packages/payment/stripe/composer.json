{
    "name": "eduardoks98/payment-stripe",
    "description": "Stripe Payment Integration for Laravel using official Stripe PHP SDK v13.x with Payment Intents, Subscriptions, and Webhooks",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "stripe",
        "payment",
        "payment-intents",
        "subscriptions",
        "webhooks",
        "stripe-sdk",
        "payments"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardo@example.com",
            "homepage": "https://github.com/eduardoks98"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "stripe/stripe-php": "^13.0",
        "eduardoks98/base-api": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\PaymentStripe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\PaymentStripe\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "Eduardoks98\\PaymentStripe\\StripeServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
