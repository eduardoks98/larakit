# Stripe API Keys
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Currency (ISO 4217)
STRIPE_CURRENCY=usd

# Stripe API Version (optional)
# Format: YYYY-MM-DD
# Leave empty to use account default
STRIPE_API_VERSION=

# Payment Configuration
STRIPE_AUTOMATIC_PAYMENT_METHODS=true
STRIPE_CAPTURE_METHOD=automatic
STRIPE_CONFIRMATION_METHOD=automatic

# Subscription Configuration
STRIPE_COLLECTION_METHOD=charge_automatically
STRIPE_DAYS_UNTIL_DUE=30
STRIPE_PRORATION_BEHAVIOR=create_prorations
STRIPE_TRIAL_PERIOD_DAYS=

# Customer Configuration
STRIPE_AUTO_CREATE_CUSTOMER=true

# Webhook Configuration
STRIPE_WEBHOOK_TOLERANCE=300

# Logging
STRIPE_LOGGING_ENABLED=true
STRIPE_LOG_CHANNEL=stack
