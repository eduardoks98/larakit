# MercadoPago Configuration Example
# Copy this file to .env and update with your credentials

# MercadoPago Credentials
# Get them from: https://www.mercadopago.com.br/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-123456-abcdef123456789012345678901234-123456789
MERCADOPAGO_PUBLIC_KEY=TEST-abcd1234-5678-90ab-cdef-1234567890ab

# Environment: sandbox or production
MERCADOPAGO_ENVIRONMENT=sandbox

# Webhook Secret (optional but recommended)
# Configure this in: https://www.mercadopago.com.br/developers/panel/webhooks
MERCADOPAGO_WEBHOOK_SECRET=

# PIX Configuration
# ISO 8601 duration format: PT30M (30 min), PT24H (24 hours), P30D (30 days)
MERCADOPAGO_PIX_EXPIRATION=PT24H

# Boleto Configuration
# Number of days until expiration (1-30)
MERCADOPAGO_BOLETO_EXPIRATION_DAYS=3

# Processing Mode: automatic or manual
MERCADOPAGO_PROCESSING_MODE=automatic

# Notification URL (optional)
# Leave empty to use default: /api/mercadopago/webhook
MERCADOPAGO_NOTIFICATION_URL=

# Statement Descriptor (appears on customer's credit card statement)
# Max 13 characters
MERCADOPAGO_STATEMENT_DESCRIPTOR=YOUR_STORE

# Logging
MERCADOPAGO_LOGGING_ENABLED=false
MERCADOPAGO_LOGGING_CHANNEL=stack
