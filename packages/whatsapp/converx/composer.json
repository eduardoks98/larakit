{
    "name": "eduardoks98/whatsapp-converx",
    "description": "Converx WhatsApp integration for Laravel - Brazilian WhatsApp provider for business messaging",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "whatsapp",
        "converx",
        "chatwoot",
        "messaging",
        "chat",
        "brazil"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8",
        "eduardoks98/base-api": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\WhatsAppConverx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\WhatsAppConverx\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\WhatsAppConverx\\WhatsAppConverxServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
