{
    "name": "eduardoks98/ads-unity",
    "description": "Unity Ads Server-to-Server (S2S) Callback Validation for Laravel - HMAC-MD5 signature verification for rewarded ads",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "unity-ads",
        "s2s",
        "rewarded-ads",
        "server-callback",
        "hmac",
        "monetization",
        "game-monetization"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardo@example.com",
            "homepage": "https://github.com/eduardoks98"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "eduardoks98/base-api": "^1.0",
        "eduardoks98/monetization": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\AdsUnity\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\AdsUnity\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\AdsUnity\\AdsUnityServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
