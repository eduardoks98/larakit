{
    "name": "eduardoks98/ads-adsense",
    "description": "Google AdSense integration for Laravel web applications with Filament admin panel support",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "adsense",
        "google-adsense",
        "ads",
        "web-ads",
        "banner-ads",
        "display-ads",
        "filament"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardo@example.com",
            "homepage": "https://github.com/eduardoks98"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "filament/filament": "^3.0"
    },
    "suggest": {
        "filament/filament": "Required for Filament admin panel integration (^3.0)",
        "google/apiclient": "Required for AdSense Management API integration (^2.0)"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\AdsAdsense\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\AdsAdsense\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\AdsAdsense\\AdsenseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
