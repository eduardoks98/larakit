{
    "name": "eduardoks98/auth",
    "description": "Modern Laravel Sanctum authentication with token abilities, device management, and optional 2FA/LDAP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "sanctum",
        "authentication",
        "api-tokens",
        "device-management",
        "2fa",
        "ldap",
        "jwt"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardo@example.com",
            "homepage": "https://github.com/eduardoks98"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "laravel/sanctum": "^3.0|^4.0",
        "eduardoks98/base-api": "^1.0",
        "eduardoks98/security": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\Auth\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\Auth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\Auth\\AuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
