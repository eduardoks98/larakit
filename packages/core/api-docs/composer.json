{
    "name": "eduardoks98/api-docs",
    "description": "Scramble OpenAPI documentation integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "dedoc/scramble": "^0.10",
        "eduardoks98/base-api": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\ApiDocs\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\ApiDocs\\ApiDocsServiceProvider"
            ]
        }
    }
}
