{
    "name": "eduardoks98/recaptcha",
    "description": "Smart Google reCAPTCHA v3/Enterprise validation with context-aware trust scoring for Laravel APIs",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "recaptcha",
        "google",
        "captcha",
        "bot-detection",
        "trust-score",
        "anti-spam",
        "security"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardo@example.com",
            "homepage": "https://github.com/eduardoks98"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8",
        "eduardoks98/base-api": "^1.0",
        "eduardoks98/security": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\Recaptcha\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\Recaptcha\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eduardoks98\\Recaptcha\\RecaptchaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
