{
    "name": "eduardoks98/helpers",
    "description": "Brazilian utilities - CPF/CNPJ validators, phone/money formatters, and more (100% framework-agnostic)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "helpers",
        "brazilian",
        "cpf",
        "cnpj",
        "brazil",
        "utilities"
    ],
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Eduardoks98\\Helpers\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Eduardoks98\\Helpers\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    }
}
