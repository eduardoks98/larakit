            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/core/auth",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/core/performance",
            "options": {"symlink": true}
        },
        {
            "type": "path",
