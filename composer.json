        {
            "type": "path",
            "url": "./packages/storage/media-library",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/brazilian/geolocation",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/brazilian/email-validator",
