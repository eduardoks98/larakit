            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/ads/facebook",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/core/permissions",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/ads/adsense",
            "options": {"symlink": true}
        }
    ],
    "autoload": {
        "psr-4": {}
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test:unit": [
            "@php vendor/bin/phpunit --testsuite Unit"
        ],
        "test:feature": [
            "@php vendor/bin/phpunit --testsuite Feature"
        ],
        "lint": [
            "vendor/bin/pint"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
