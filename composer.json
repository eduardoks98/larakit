{
    "name": "eduardoks98/larakit",
    "description": "Larakit - Monorepo with reusable Laravel packages",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Eduardo Steffens",
            "email": "eduardoks98@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6"
    },
    "repositories": [
        {
            "type": "path",
            "url": "./packages/core/base-api",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/core/helpers",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/core/security",
            "options": {"symlink": true}
        },
        {
            "type": "path",
            "url": "./packages/core/rate-limiter",
            "options": {"symlink": true}
        },
        {
            "type": "path",
