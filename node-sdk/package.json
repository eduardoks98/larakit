{
  "name": "@mysys/game-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "MySys Game SDK - Biblioteca compartilhada para desenvolvimento de jogos",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:shared": "npm run build -w @mysys/game-sdk-shared",
    "build:server": "npm run build -w @mysys/game-sdk-server",
    "build:client": "npm run build -w @mysys/game-sdk-client",
    "clean": "rimraf packages/*/dist",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "rimraf": "^5.0.5",
    "eslint": "^8.55.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eduardoks98/larakit.git",
    "directory": "node-sdk"
  },
  "author": "MySys",
  "license": "MIT"
}
