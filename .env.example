# Application
APP_NAME="Larakit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=larakit
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Laravel Sanctum (eduardoks98/auth)
SANCTUM_ACCESS_TOKEN_EXPIRATION=15
SANCTUM_REFRESH_TOKEN_EXPIRATION=10080
SANCTUM_DEVICE_ID_ENABLED=true
SANCTUM_MAX_DEVICES=5

# Session Tracking
SESSION_TRACKING_ENABLED=true
SESSION_CLEANUP_DAYS=30

# Rate Limiter (eduardoks98/rate-limiter)
RATE_LIMITER_ENABLED=true
RATE_LIMITER_TIME_DECAY_MINUTES=1
MAX_ATTEMPTS_BEFORE_BAN_IP=100
RATE_LIMITER_MAX_ATTEMPTS=60
THROTTLE_MAX_ATTEMPTS=30
RATE_LIMITER_BAN_DURATION=60
RATE_LIMITER_WHITELIST_ENABLED=true
RATE_LIMITER_GEOLOCATION_ENABLED=true
RATE_LIMITER_INJECTION_DETECTION=true
RATE_LIMITER_VOLUME_ANOMALY_DETECTION=true
RATE_LIMITER_LOG_REQUESTS=true
RATE_LIMITER_LOG_ONLY_BLOCKED=false
RATE_LIMITER_FAIL2BAN_ENABLED=false
RATE_LIMITER_FAIL2BAN_JAIL=laravel-api

# reCAPTCHA (eduardoks98/recaptcha)
RECAPTCHA_ENABLED=true
RECAPTCHA_V3_SECRET=your_recaptcha_v3_secret
RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key
RECAPTCHA_THRESHOLD=0.5
RECAPTCHA_HIGH_TRUST=0.7
RECAPTCHA_MEDIUM_TRUST=0.5
RECAPTCHA_LOW_TRUST=0.3
RECAPTCHA_AUTO_APPROVE=0.8
RECAPTCHA_AUTO_REJECT=0.2
RECAPTCHA_LOG_ENABLED=true
RECAPTCHA_VERIFY_SSL=true

# reCAPTCHA Enterprise (optional)
RECAPTCHA_ENTERPRISE_ENABLED=false
RECAPTCHA_ENTERPRISE_API_KEY=
RECAPTCHA_PROJECT_ID=

# Security (eduardoks98/security)
SECURITY_HEADERS_ENABLED=true
IP_BLOCKING_ENABLED=true
CSP_ENABLED=true

# Performance Monitoring (eduardoks98/performance)
PERFORMANCE_MONITORING_ENABLED=true
SLOW_REQUEST_THRESHOLD=1000
LOG_QUERIES=false
LOG_MEMORY=true
PERFORMANCE_SAMPLE_RATE=1.0

# Laravel Pulse (Laravel 11+)
PULSE_ENABLED=false
PULSE_DOMAIN=localhost

# Health Checks (eduardoks98/health)
HEALTH_CHECKS_ENABLED=true
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_CACHE=true
HEALTH_CHECK_QUEUE=true

# Laravel Reverb (WebSocket - Laravel 11+)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=false

# Laravel Horizon (Queue Dashboard)
HORIZON_ENABLED=false

# Laravel Telescope (Development Only)
TELESCOPE_ENABLED=true

# JWT (Optional - eduardoks98/auth)
JWT_ENABLED=false
JWT_ALGORITHM=RS256
JWT_TTL=60
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# LDAP (Optional - eduardoks98/auth)
LDAP_ENABLED=false
LDAP_HOST=
LDAP_PORT=389
LDAP_BASE_DN=
LDAP_USERNAME=
LDAP_PASSWORD=
LDAP_USE_SSL=false
LDAP_USE_TLS=false

# Two-Factor Authentication (Optional - eduardoks98/auth)
TWO_FACTOR_ENABLED=false
TWO_FACTOR_ISSUER="${APP_NAME}"

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_EXPIRES_DAYS=0

# Login Security
LOGIN_LOG_ATTEMPTS=true
LOGIN_NOTIFY_NEW_DEVICE=false
LOGIN_REQUIRE_EMAIL_VERIFICATION=false

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
